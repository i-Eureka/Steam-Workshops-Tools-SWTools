<Window x:Class="SWTools.WPF.SteamGuardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Steam Guard 验证"
        Height="180" Width="420"
        ResizeMode="NoResize"
        Background="{StaticResource BhDefault}" ThemeMode="Light"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 10 0 0">
            <Button x:Name="BtnOk" Content="确定" Width="80" Click="BtnOk_Click" IsDefault="True" Margin="0 0 10 0"/>
            <Button x:Name="BtnCancel" Content="取消" Width="80" Click="BtnCancel_Click" IsCancel="True"/>
        </StackPanel>
        <StackPanel>
            <TextBlock TextWrapping="Wrap" Margin="0 0 0 12"
                Text="Steam 需要进行二步验证。请打开 Steam 手机 App 或您的邮箱，输入动态令牌（验证码）："/>
            <TextBox x:Name="TxtCode" FontSize="18" FontFamily="Consolas"
                     MaxLength="10" HorizontalContentAlignment="Center"
                     KeyDown="TxtCode_KeyDown"/>
        </StackPanel>
    </DockPanel>
</Window>
